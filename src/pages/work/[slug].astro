---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Flow from '../../components/Flow.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project: p } = Astro.props;
const idx = projects.findIndex((x) => x.slug === p.slug);
const next = projects[(idx + 1) % projects.length];
---
<Base title={p.title} description={p.subtitle} home={false}>
  <article class="container-prose py-12 sm:py-20">
    <a href="/#work" class="inline-flex items-center gap-1.5 text-sm text-fg-muted hover:text-fg">
      <Icon name="arrow-left" size={15} /> All work
    </a>

    <header class="mt-8 max-w-3xl">
      <p class="eyebrow">{p.org} · {p.period}</p>
      <h1 class="mt-3 text-4xl font-semibold leading-tight tracking-tightest text-fg sm:text-5xl">{p.title}</h1>
      <p class="mt-4 text-xl leading-relaxed text-fg-muted">{p.subtitle}</p>
      <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Technologies">
        {p.tags.map((t) => <li class="rounded-md bg-bg-muted px-2 py-0.5 font-mono text-[11px] text-fg-muted">{t}</li>)}
      </ul>
      {p.links && (
        <ul class="mt-6 flex flex-wrap gap-3">
          {p.links.map((l) => (
            <li>
              <a href={l.href} rel="noopener" class="inline-flex h-9 items-center gap-1.5 rounded-full border border-line-strong px-4 text-sm font-medium text-fg hover:border-fg">
                {l.label} <Icon name="arrow-up-right" size={14} />
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>

    <div class="mt-12">
      <Flow steps={p.flow} />
    </div>

    <div class="mt-14 space-y-12 md:space-y-16">
      <section class="grid gap-3 md:grid-cols-[180px_1fr] md:gap-x-12">
        <h2 class="eyebrow md:pt-1">Context</h2>
        <p class="max-w-2xl text-[17px] leading-relaxed text-fg-muted">{p.context}</p>
      </section>

      <section class="grid gap-3 md:grid-cols-[180px_1fr] md:gap-x-12">
        <h2 class="eyebrow md:pt-1">What I built</h2>
        <ul class="max-w-2xl space-y-3">
          {p.built.map((b) => (
            <li class="relative pl-5 leading-relaxed text-fg-muted before:absolute before:left-0 before:top-[0.7em] before:size-1.5 before:rounded-full before:bg-accent">{b}</li>
          ))}
        </ul>
      </section>

      <section class="grid gap-3 md:grid-cols-[180px_1fr] md:gap-x-12">
        <h2 class="eyebrow md:pt-1">Key decisions</h2>
        <dl class="max-w-2xl space-y-4">
          {p.decisions.map((d) => (
            <div class="rounded-card border border-line bg-bg-elevated p-5">
              <dt class="font-semibold tracking-tight text-fg">{d.title}</dt>
              <dd class="mt-1.5 leading-relaxed text-fg-muted">{d.body}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="grid gap-3 md:grid-cols-[180px_1fr] md:gap-x-12">
        <h2 class="eyebrow md:pt-1">Impact</h2>
        <ul class="max-w-2xl space-y-3">
          {p.impact.map((b) => (
            <li class="relative pl-5 leading-relaxed text-fg before:absolute before:left-0 before:top-[0.7em] before:size-1.5 before:rounded-full before:bg-accent">{b}</li>
          ))}
        </ul>
      </section>
    </div>

    <nav class="mt-20 border-t border-line pt-8" aria-label="Next case study">
      <p class="eyebrow">Next</p>
      <a href={`/work/${next.slug}`} class="group mt-2 inline-flex items-center gap-2 text-xl font-semibold tracking-tight text-fg">
        {next.title}
        <Icon name="arrow-right" class="transition-transform group-hover:translate-x-0.5" />
      </a>
    </nav>
  </article>
</Base>
