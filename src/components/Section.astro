---
interface Props { id: string; eyebrow: string; title: string; class?: string }
const { id, eyebrow, title, class: className = '' } = Astro.props;
---
<section id={id} class:list={['section-y scroll-mt-20', className]} aria-labelledby={`${id}-title`}>
  <div class="container-prose">
    <div class="mb-8 sm:mb-10">
      <p class="eyebrow mb-3">{eyebrow}</p>
      <h2 id={`${id}-title`} class="text-3xl font-semibold tracking-tightest text-fg sm:text-4xl">{title}</h2>
    </div>
    <slot />
  </div>
</section>
