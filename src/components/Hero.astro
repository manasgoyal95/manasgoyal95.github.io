---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

// Derived at build time so the badge never goes stale.
const years = Math.floor(
  (Date.now() - new Date(profile.careerStart).getTime()) / (365.25 * 24 * 60 * 60 * 1000),
);
const experience = `${years} yr${years === 1 ? '' : 's'} experience`;
---
<section class="container-prose pt-10 pb-12 sm:pt-16 sm:pb-16" aria-label="Introduction">
  <div class="max-w-3xl">
    <p class="surface rise inline-flex max-w-full items-center gap-2 rounded-full border border-line bg-bg-elevated px-3 py-1.5 font-mono text-xs text-fg-muted">
      <span class="relative flex size-2 shrink-0">
        <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60"></span>
        <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
      </span>
      <span class="min-w-0">
        {profile.role} · {experience} · {profile.company} · {profile.location}
      </span>
    </p>

    <h1 class="rise rise-1 mt-6 text-5xl font-semibold leading-[1.02] tracking-tightest text-fg sm:text-7xl">
      {profile.name}
    </h1>

    <p class="rise rise-2 mt-6 max-w-2xl text-xl leading-relaxed text-fg-muted sm:text-2xl">
      {profile.tagline}
    </p>
    <p class="rise rise-2 mt-5 max-w-2xl text-base leading-relaxed text-fg-muted sm:text-[17px]">
      {profile.summary}
    </p>

    <div class="rise rise-3 mt-8 flex flex-wrap items-center gap-3">
      <a href="#work" class="inline-flex h-11 items-center gap-2 rounded-full bg-fg px-5 text-sm font-medium text-bg transition-opacity hover:opacity-85">
        See selected work <Icon name="arrow-right" size={16} />
      </a>
      <div class="ml-1 flex items-center gap-1">
        <a href={profile.links.github} target="_blank" rel="me noopener" class="inline-flex size-10 items-center justify-center rounded-full text-fg-muted hover:bg-bg-muted hover:text-fg" aria-label="GitHub"><Icon name="github" /></a>
        <a href={profile.links.linkedin} target="_blank" rel="me noopener" class="inline-flex size-10 items-center justify-center rounded-full text-fg-muted hover:bg-bg-muted hover:text-fg" aria-label="LinkedIn"><Icon name="linkedin" /></a>
        <a href={`mailto:${profile.email}`} class="inline-flex size-10 items-center justify-center rounded-full text-fg-muted hover:bg-bg-muted hover:text-fg" aria-label="Email"><Icon name="mail" /></a>
      </div>
    </div>
  </div>
</section>
