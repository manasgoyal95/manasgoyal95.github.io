---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { personalProjects } from '../data/personal';
---
<Section id="projects" eyebrow="Personal projects" title="Things I've built on my own time" class="border-t border-line">
  <ul class="grid gap-4 sm:grid-cols-2">
    {personalProjects.map((p) => (
      <li class="flex flex-col rounded-card border border-line bg-bg-elevated p-6">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="eyebrow">{p.year}</p>
            <h3 class="mt-1.5 text-lg font-semibold tracking-tight text-fg">{p.name}</h3>
          </div>
          <a href={p.repo} rel="noopener" class="inline-flex size-9 shrink-0 items-center justify-center rounded-full text-fg-muted transition-colors hover:bg-bg-muted hover:text-fg" aria-label={`${p.name} on GitHub`}>
            <Icon name="github" />
          </a>
        </div>
        <p class="mt-3 flex-1 text-sm leading-relaxed text-fg-muted">{p.description}</p>
        <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Technologies">
          {p.stack.map((t) => <li class="rounded-md bg-bg-muted px-2 py-0.5 font-mono text-[11px] text-fg-muted">{t}</li>)}
        </ul>
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium">
          {p.caseStudy && (
            <a href={`/work/${p.caseStudy}`} class="inline-flex items-center gap-1 text-fg hover:text-accent">
              Case study <Icon name="arrow-right" size={15} />
            </a>
          )}
          <a href={p.repo} rel="noopener" class="inline-flex items-center gap-1 text-fg hover:text-accent">
            Source <Icon name="arrow-up-right" size={15} />
          </a>
          {p.demo && (
            <a href={p.demo} rel="noopener" class="inline-flex items-center gap-1 text-fg hover:text-accent">
              Live demo <Icon name="arrow-up-right" size={15} />
            </a>
          )}
        </div>
      </li>
    ))}
  </ul>
</Section>
