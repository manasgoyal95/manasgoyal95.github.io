---
import Section from './Section.astro';
import { experience } from '../data/experience';
---
<Section id="experience" eyebrow="Experience" title="Where I've worked" class="border-t border-line">
  <ol class="space-y-12">
    {experience.map((e) => (
      <li class="grid gap-6 md:grid-cols-[200px_1fr] md:gap-10">
        <div>
          <p class="font-mono text-sm text-fg-subtle">{e.start} — {e.end}</p>
        </div>
        <div>
          <h3 class="title-ui text-xl text-fg">{e.role}</h3>
          <p class="mt-0.5 text-fg-muted">{e.company}</p>
          <p class="mt-4 max-w-2xl text-fg-muted">{e.summary}</p>
          <ul class="mt-5 max-w-2xl space-y-3">
            {e.bullets.map((b) => (
              <li class="relative pl-5 text-[15px] leading-relaxed text-fg-muted before:absolute before:left-0 before:top-[0.7em] before:size-1.5 before:rounded-full before:bg-accent">{b}</li>
            ))}
          </ul>
          <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Stack">
            {e.stack.map((t) => <li class="rounded-md border border-line px-2 py-0.5 font-mono text-[11px] text-fg-muted">{t}</li>)}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</Section>
