---
import { profile } from '../data/profile';
---
<div class="mb-8 sm:mb-10">
  <p class="max-w-2xl text-[15px] leading-relaxed text-fg-muted">{profile.statsIntro}</p>

  <dl class="surface mt-5 grid grid-cols-1 gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
    {profile.stats.map((s) => (
      <div class="flex flex-col bg-bg-elevated px-5 py-5 sm:px-6 sm:py-6">
        <dd class="font-mono text-3xl font-medium tracking-tight text-fg sm:text-4xl">{s.value}</dd>
        <dt class="mt-1.5 text-sm font-medium text-fg">{s.label}</dt>
        <p class="mt-2 text-[13px] leading-relaxed text-fg-subtle">{s.note}</p>
      </div>
    ))}
  </dl>
</div>
